{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@mobiletrust/shared": ["./packages/shared/src/index.ts"],
      "@mobiletrust/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "packages/**/*",
    "apps/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist", "build", "android", "ios"]
}
