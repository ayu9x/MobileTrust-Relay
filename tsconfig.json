{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@mobiletrust/shared": ["./packages/shared/src/index.ts"],
      "@mobiletrust/shared/*": ["./packages/shared/src/*"]
    }
  },
  "include": [
    "packages/**/*",
    "apps/mobile/src/crypto/**/*",
    "apps/mobile/src/services/**/*",
    "apps/mobile/src/store/**/*",
    "tests/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}
